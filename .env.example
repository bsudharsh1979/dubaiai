# RainReady UAE — environment template (copy to rainready/api/.env for local runs).
# Defaults run the no-key demo: synthetic data, deterministic "demo" provider, simulated connectors.
# Every switch below is displayed in the UI; nothing is switched silently.

APP_ENV=local                 # local | hosted | production  (production refuses DEMO_AUTH=true)
PORT=8100
CORS_ORIGINS=["http://localhost:3100","http://127.0.0.1:3100"]
STATIC_DIR=                    # set to ../web/out to serve the exported UI from the API

# Provenance switches ---------------------------------------------------------
DATA_MODE=synthetic            # synthetic | historical_replay | connected (connected is refused until authorized adapters exist)
MODEL_PROVIDER=demo            # demo | local_nim | approved_hosted  (never auto-switched; failures are shown)
ACTION_CONNECTORS=simulated    # simulated only — no real valve/power/evacuation endpoint exists in this MVP
SOVEREIGN_MODE=true            # no cloud fallback; LLM_BASE_URL must match PROVIDER_ALLOWLIST

# Persistence ----------------------------------------------------------------
DATABASE_URL=sqlite:///./data/rainready.db
# DATABASE_URL=postgresql+psycopg://rainready:rainready@db:5432/rainready   (Compose; enables PostGIS geom columns + pgvector)
AUTO_MIGRATE=true
AUTO_SEED=true
ATTACHMENTS_DIR=./data/attachments
RASTERS_DIR=./data/rasters

# Identity (server-side; the client never sends a role) ----------------------
DEMO_AUTH=true                 # passwordless demo identity switcher (disabled automatically in production)
SESSION_SECRET=change-me-rainready-0123456789abcdef   # MUST be replaced outside local
COOKIE_SECURE=false            # true behind HTTPS

# Operations ------------------------------------------------------------------
APPROVAL_TTL_MINUTES=30
ACK_ESCALATION_MINUTES=15
MAX_EVIDENCE_LOOPS=2
RETRY_BUDGET=3
WORKER_ENABLED=true

# Text planning provider (shared by all personas) ----------------------------
# local_nim example (self-hosted NIM / vLLM, OpenAI-compatible):
# LLM_BASE_URL=http://nim-llm:8000/v1
# LLM_MODEL=                    # leave empty, then copy the exact id from GET /v1/models (never assumed)
# LLM_API_KEY=
# approved_hosted example (allow-listed; sovereign_mode must be false and is shown as such):
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=nvidia/nemotron-nano-3-30b-a3b
LLM_TIMEOUT_S=90
LLM_MAX_TOOL_ITERATIONS=6
LLM_MAX_TOKENS=1500
PROVIDER_ALLOWLIST=["http://localhost","http://127.0.0.1","http://nim-","https://integrate.api.nvidia.com"]

# Embeddings / rerank (optional; lexical BM25 fallback is used and labelled otherwise)
EMBED_BASE_URL=
EMBED_MODEL=                   # e.g. served id of nvidia/nemotron-3.5-embed-1b — discover via /v1/models
EMBED_API_KEY=
RERANK_BASE_URL=
RERANK_MODEL=

# Guards (optional model adapters; the deterministic gate is always on) ------
GUARD_CONTENT_SAFETY_URL=      # nvidia/nemotron-3.5-content-safety (chat-completions contract)
GUARD_CONTENT_SAFETY_MODEL=
GUARD_JAILBREAK_URL=           # NemoGuard JailbreakDetect classification API
GUARD_API_KEY=
GUARD_REQUIRED_FOR_PUBLICATION=false   # true → publication blocked while a guard adapter is unhealthy

# Optional visual evidence (RGB field photos only; SAR arrays are never passed)
VISION_BASE_URL=
VISION_MODEL=
VISION_API_KEY=
